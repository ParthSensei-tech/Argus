# ============================================================
# Argus environment configuration
# Copy to .env and fill in. Secrets may also live in keystore.env
# (gitignored) — the backend reads both. Never commit real keys.
# ============================================================

# --- Core ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
# Production (Docker): postgresql+psycopg://argus:argus@db:5432/argus
# Local dev without Docker: sqlite:///./data/argus_dev.db
DATABASE_URL=sqlite:///./data/argus_dev.db
REDIS_URL=redis://localhost:6379/0
# true = run background jobs inline (no Redis needed, dev only)
CELERY_TASK_ALWAYS_EAGER=true
CORS_ORIGINS=http://localhost:3000

# --- AI provider adapter (OpenAI-compatible endpoints) ---
# Keys: use the named keystore entries (OPENROUTER_API_KEY_NVIDIA etc.)
# or set per-role keys here. Per-role keys win over keystore entries.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_API_KEY=
VISION_MODEL=google/gemma-4-26b-a4b-it:free
VISION_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS_REASONING=8000
LLM_MAX_TOKENS_FAST=2000
LLM_DAILY_REQUEST_BUDGET=45
# true = clearly-labelled deterministic dev output (no AI calls).
# Never present dev-mode output as genuine AI analysis.
AI_DEV_MODE=false

# --- Embeddings ---
# openrouter = Qwen3-Embedding-8B (PAID ~$0.01/M tokens, hash-cached)
# local      = sentence-transformers (free; pip install -r requirements-local-embeddings.txt; set DIM=1024)
# dev        = deterministic hash vectors, clearly labelled, tests/offline only
EMBEDDING_PROVIDER=openrouter
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096
EMBEDDING_MAX_TOKENS_PER_MONTH=2000000
EMBEDDING_LOCAL_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Storage ---
# local = private directory + HMAC signed URLs; supabase = Supabase Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
SIGNED_URL_TTL_SECONDS=900
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=argus-private

# --- Upload limits (adjustable, not hardcoded) ---
MAX_UPLOAD_MB=25
MAX_DOCUMENT_PAGES=100
RATE_LIMIT_PER_MINUTE=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000